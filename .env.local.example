# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Demo guest login without Supabase Auth
NEXT_PUBLIC_DEMO_MODE=true

# Sync / cron
CRON_SECRET=change-me
FOOTBALL_API_KEY=
FOOTBALL_LEAGUE_ID=39
FOOTBALL_SEASON=2025

# Optional FastAPI engine (falls back to local TypeScript poisson-v1)
AI_ENGINE_URL=

# Product limits (Phase 9–10)
FREE_DAILY_PREDICT_LIMIT=8
# Pro unlock is demo cookie-based via /pricing (no Stripe yet)

# Predict engine (Phase upgrades)
# Monte Carlo runs — confirmed XI near kickoff uses the higher value
PREDICT_SIM_ITERATIONS=20000
PREDICT_SIM_ITERATIONS_CONFIRMED=25000

# Season note: free API-Football plans often only allow 2022–2024.
# Paid plans: set FOOTBALL_SEASON to the current season start year (e.g. 2026).
FOOTBALL_SEASON=2024
