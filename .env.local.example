# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Demo guest login without Supabase Auth
NEXT_PUBLIC_DEMO_MODE=true

# Sync / cron
CRON_SECRET=change-me
FOOTBALL_API_KEY=
FOOTBALL_LEAGUE_ID=39
# Competition start year. Live PL on Sep 2026 → 2026.
# Free API-Football plans usually only allow 2022–2024; sync auto-falls back to 2024.
FOOTBALL_SEASON=2026

# Free live fixtures + standings (recommended). Register at https://www.football-data.org/client/register
# When set, hourly/nightly sync prefer football-data.org for the current season.
FOOTBALL_DATA_TOKEN=

# Optional FastAPI engine (falls back to local TypeScript poisson-v1)
AI_ENGINE_URL=

# Product limits (Phase 9–10)
FREE_DAILY_PREDICT_LIMIT=8
# Pro unlock is demo cookie-based via /pricing (no Stripe yet)

# Predict engine (performance-tuned defaults)
# Monte Carlo runs — free uses the lower value; Pro uses base / confirmed
PREDICT_SIM_ITERATIONS=4000
PREDICT_SIM_ITERATIONS_CONFIRMED=8000
PREDICT_SIM_ITERATIONS_FREE=2500
